<Window x:Class="PokeMacroBuilder.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マクロ名の入力" Height="180" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBgBrush}" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Text="表示名を入力してください:" Margin="0,0,0,8"/>
        <TextBox x:Name="Input" Grid.Row="1" Height="30"
                 KeyDown="Input_KeyDown"/>
        <TextBlock x:Name="HintText" Grid.Row="2" Foreground="{StaticResource TextDimBrush}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="※ この名前は Poke-Controller 上の表示名になります。ファイル名は自動で決まります。"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="90" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
