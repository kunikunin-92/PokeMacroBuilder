<Window x:Class="PokeMacroBuilder.Views.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="テンプレ画像のトリミング" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Background="{StaticResource PanelBgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"
                   Text="ドラッグで認識させたい範囲を選択（選択しなければ画像全体を使用）"/>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                HorizontalAlignment="Center" Background="#FF101010">
            <Grid>
                <Image x:Name="Img" Stretch="Fill"/>
                <Canvas x:Name="CropCanvas" Background="#01FFFFFF" Cursor="Cross"
                        PreviewMouseLeftButtonDown="Canvas_Down"
                        PreviewMouseMove="Canvas_Move"
                        PreviewMouseLeftButtonUp="Canvas_Up">
                    <Rectangle x:Name="Sel" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                               Fill="#330078D4" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="範囲をクリア" Width="100" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="キャンセル" Width="100" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="追加" Width="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
