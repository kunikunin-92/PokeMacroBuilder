<Window x:Class="PokeMacroBuilder.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PokeMacroBuilder.Models"
        Title="マクロ編集" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource EditorBgBrush}">

    <Window.Resources>

        <!-- ボタン押下ブロック -->
        <DataTemplate DataType="{x:Type models:PressBlock}">
            <Border Background="#FF4C97FF" CornerRadius="6" Padding="0" Margin="0,0,0,2"
                    AllowDrop="True">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3AE;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ボタンを押す" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- キースロット(複数=同時押し) -->
                        <ItemsControl ItemsSource="{Binding Keys}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="150" Height="26"
                                                      ItemsSource="{x:Static models:KeyCatalog.All}"
                                                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}"/>
                                            <Button Content="&#x2716;" Width="24" Height="26" Margin="4,0,0,0"
                                                    Padding="0" ToolTip="このキーを削除"
                                                    Click="RemoveKeySlot_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="&#x2795; キー追加 (同時押し)" Height="26" Padding="8,2"
                                    Click="AddKeySlot_Click"/>
                        </StackPanel>

                        <!-- 押す時間 / 待機 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="押す時間" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="60" Height="26" Margin="6,0,2,0"
                                     Text="{Binding Duration, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <TextBlock Text="後で待つ" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="60" Height="26" Margin="6,0,2,0"
                                     Text="{Binding Wait, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 並べ替え/削除 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="28" Height="24" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="28" Height="24" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2716;" Width="28" Height="24" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 待機ブロック -->
        <DataTemplate DataType="{x:Type models:WaitBlock}">
            <Border Background="#FFFFAB19" CornerRadius="6" Padding="0" Margin="0,0,0,2"
                    AllowDrop="True">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x23F1;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="待機する" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center"/>
                        <TextBox Width="70" Height="26" Margin="12,0,2,0"
                                 Text="{Binding Seconds, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="秒" Foreground="#FF3B2A00" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="28" Height="24" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="28" Height="24" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2716;" Width="28" Height="24" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBgBrush}" Padding="14,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="&#x2190; 戻る" Width="80" Margin="0,0,16,0" Click="Back_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="表示名:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="DisplayNameBox" Width="220" Height="30" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="繰り返し:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="LoopBox" Width="130" Height="30" VerticalAlignment="Center"
                              SelectionChanged="LoopBox_SelectionChanged">
                        <ComboBoxItem Content="なし (1回)"/>
                        <ComboBoxItem Content="無限ループ"/>
                        <ComboBoxItem Content="回数を指定"/>
                    </ComboBox>
                    <TextBox x:Name="LoopCountBox" Width="60" Height="30" Margin="6,0,0,0"
                             VerticalAlignment="Center" Text="10" Visibility="Collapsed"/>
                    <TextBlock x:Name="LoopCountUnit" Text="回" VerticalAlignment="Center" Margin="4,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="&#x1F441; プレビュー更新" Width="140" Margin="0,0,8,0" Click="Preview_Click"/>
                    <Button Content="&#x1F4BE; 保存" Width="110" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 本体: パレット | スクリプト | プレビュー -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- パレット -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="ブロック" FontWeight="SemiBold" FontSize="14" Margin="2,2,0,10"/>

                    <Button Margin="0,0,0,8" Height="46" HorizontalContentAlignment="Left"
                            Background="#FF4C97FF" BorderBrush="#FF3B7DDB" Click="AddPress_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3AE;" FontSize="16" Margin="2,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="ボタンを押す" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="押す時間 / 待機を指定" FontSize="10" Foreground="#DDFFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,0,8" Height="46" HorizontalContentAlignment="Left"
                            Background="#FF9966FF" BorderBrush="#FF7A4DDB" Click="AddCombo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F517;" FontSize="16" Margin="2,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="同時押し" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="複数キーを同時に押す" FontSize="10" Foreground="#DDFFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,0,8" Height="46" HorizontalContentAlignment="Left"
                            Background="#FFFFAB19" BorderBrush="#FFD98E0F" Click="AddWait_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x23F1;" FontSize="16" Margin="2,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="待機する" FontWeight="Bold" Foreground="#FF3B2A00"/>
                                <TextBlock Text="指定秒だけ何もしない" FontSize="10" Foreground="#993B2A00"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource EditorBgBrush}" CornerRadius="4" Padding="10" Margin="0,12,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ヒント" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                       Text="ブロックをクリックして下のスクリプトに追加。▲▼で並べ替え、ドラッグでも移動できます。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- スクリプト領域 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="18">
                <StackPanel>
                    <Border Background="#FF3C7D3C" CornerRadius="6" Padding="14,10" Margin="0,0,0,2">
                        <TextBlock Text="&#x25B6; マクロ開始" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <ItemsControl x:Name="BlocksHost"
                                  PreviewMouseMove="BlocksHost_PreviewMouseMove"
                                  PreviewMouseLeftButtonDown="BlocksHost_PreviewMouseDown"
                                  Drop="BlocksHost_Drop" AllowDrop="True"/>

                    <Border Background="#FF6E3030" CornerRadius="6" Padding="14,10" Margin="0,2,0,0">
                        <TextBlock x:Name="EndLabel" Text="&#x25A0; マクロ終了" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <TextBlock x:Name="EmptyScriptHint"
                               Text="左のパレットからブロックを追加してください。"
                               Foreground="{StaticResource TextDimBrush}" Margin="4,16,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- プレビュー -->
            <Border Grid.Column="2" Background="{StaticResource PanelBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="生成されるPython" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,8"/>
                    <Border Grid.Row="1" Background="{StaticResource EditorBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                            <TextBox x:Name="PreviewBox" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" FontFamily="Consolas" FontSize="12"
                                     TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
