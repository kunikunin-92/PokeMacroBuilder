<Window x:Class="PokeMacroBuilder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="280" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Background="{StaticResource PanelBgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="OCR (文字認識)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Tesseract のパス (tesseract.exe)" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Height="30" VerticalAlignment="Center" TextChanged="PathBox_TextChanged"/>
            <Button Grid.Column="1" Content="参照..." Width="80" Height="30" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>
        <TextBlock x:Name="PathStatus" Grid.Row="3" Margin="0,6,0,0" FontSize="11" Text=""/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
            <TextBlock Text="テーマ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ThemeBox" Width="160" Height="30">
                <ComboBoxItem Content="ダーク"/>
                <ComboBoxItem Content="ライト"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="100" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="100" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
