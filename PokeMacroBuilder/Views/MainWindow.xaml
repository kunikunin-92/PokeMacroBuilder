<Window x:Class="PokeMacroBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeMacroBuilder" Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource EditorBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー風ヘッダー -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBgBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F9E9;" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="PokeMacro Builder" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="ブロックでpokeconマクロを作成" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
            </StackPanel>
        </Border>

        <!-- ワークスペース行 -->
        <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}" Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ワークスペース:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextDimBrush}"/>
                <Border Grid.Column="1" Background="{StaticResource EditorBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                        Padding="8,5">
                    <TextBlock x:Name="WorkspacePathText" Text="(未選択)" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Border>
                <Button Grid.Column="2" Content="フォルダを選択..." Margin="10,0,0,0"
                        Click="ChooseWorkspace_Click"/>
            </Grid>
        </Border>

        <!-- マクロ一覧 -->
        <Grid Grid.Row="2" Margin="16,14,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="このツールで作成したマクロ" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>

            <ListBox x:Name="MacroList" Grid.Row="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="MacroList_MouseDoubleClick"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="{StaticResource PanelBgBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="14,12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x1F4C4;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SubText}" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="まだマクロがありません。「新規作成」から始めましょう。"
                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- 下部アクション -->
        <Border Grid.Row="3" Background="{StaticResource ToolbarBgBrush}" Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#x1F5D1; 削除" Width="100" Margin="0,0,8,0" Click="Delete_Click"/>
                <Button Content="&#x270F; 開く / 編集" Width="130" Margin="0,0,8,0" Click="Open_Click"/>
                <Button Content="&#x2795; 新規作成" Width="130" Style="{StaticResource AccentButton}"
                        Click="New_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
