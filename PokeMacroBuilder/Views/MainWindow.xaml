<Window x:Class="PokeMacroBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PokeMacroBuilder.Models"
        xmlns:conv="clr-namespace:PokeMacroBuilder.Converters"
        Title="PokeMacro Builder" Height="900" Width="1480"
        MinHeight="700" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Background="{StaticResource EditorBgBrush}">

    <Window.Resources>
        <conv:DirectionSelectedConverter x:Key="DirSel"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- パレットのブロック(クリック=末尾追加 / ドラッグ=任意位置へ配置) -->
        <Style x:Key="PaletteBlockButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="右のスクリプトへドラッグして配置"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PaletteBlock_Down"/>
            <EventSetter Event="PreviewMouseMove" Handler="PaletteBlock_Move"/>
        </Style>

        <!-- ===== タブ(編集中ファイル) ===== -->
        <DataTemplate x:Key="TabTemplate">
            <Border x:Name="tabBd" Background="{StaticResource ShellBgBrush}" Cursor="Hand"
                    BorderBrush="Transparent" BorderThickness="0,2,0,0" Margin="0,0,1,0"
                    MouseLeftButtonUp="Tab_Click">
                <StackPanel Orientation="Horizontal" Margin="12,6,6,6">
                    <TextBlock Text="&#x1F4C4;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="tabName" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#x2715;" Width="18" Height="18" Margin="8,0,0,0" Padding="0" FontSize="9"
                            Click="TabClose_Click" Tag="{Binding}" ToolTip="閉じる"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="tabBd" Property="Background" Value="{StaticResource EditorBgBrush}"/>
                    <Setter TargetName="tabBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="tabName" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="tabName" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== ボタン押下ブロック ===== -->
        <DataTemplate DataType="{x:Type models:PressBlock}">
            <Border Background="#FF4C97FF" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F3AE;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ボタン" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Width="120" Height="28" SelectedIndex="{Binding Mode, Mode=TwoWay}"
                                      SelectionChanged="Field_SelectionChanged">
                                <ComboBoxItem Content="押す"/>
                                <ComboBoxItem Content="押し続ける"/>
                                <ComboBoxItem Content="離す"/>
                            </ComboBox>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Keys}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#33000000" CornerRadius="3" Padding="4,3" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="160" Height="28"
                                                      ItemsSource="{x:Static models:KeyCatalog.All}"
                                                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}"/>
                                            <Button Content="&#x2715;" Width="28" Height="28" Margin="4,0,0,0"
                                                    Padding="0" ToolTip="このキーを削除" Click="RemoveKeySlot_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="addKeyBtn" Content="&#x2795; キー追加 (同時押し)" Height="28" Padding="10,2"
                                HorizontalAlignment="Left" Click="AddKeySlot_Click"/>

                        <!-- 押す(連打可) -->
                        <StackPanel x:Name="pressTiming" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="押す時間" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Duration, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Text="待機" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Wait, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Text="連打" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="48" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     ToolTip="1なら1回。2以上で連打になり、待機の値が押下間隔になります" Text="{Binding Repeat, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="回" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 押し続ける(hold) -->
                        <StackPanel x:Name="holdTiming" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="待機" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Wait, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒  (押したままにします。別ブロックで「離す」を)" Foreground="#DDFFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="1">
                    <Setter TargetName="pressTiming" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="holdTiming" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="2">
                    <Setter TargetName="pressTiming" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== スティック / 方向ブロック ===== -->
        <DataTemplate DataType="{x:Type models:StickBlock}">
            <Border Background="#FF9966FF" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 8方向パッド(3x3) -->
                    <Border Grid.Column="0" Background="#33000000" CornerRadius="6" Padding="6" VerticalAlignment="Top">
                        <Grid Width="120" Height="120">
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Tag="0" Content="↑" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=0}"/>
                            <Button Grid.Row="0" Grid.Column="2" Tag="1" Content="↗" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=1}"/>
                            <Button Grid.Row="1" Grid.Column="2" Tag="2" Content="→" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=2}"/>
                            <Button Grid.Row="2" Grid.Column="2" Tag="3" Content="↘" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=3}"/>
                            <Button Grid.Row="2" Grid.Column="1" Tag="4" Content="↓" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=4}"/>
                            <Button Grid.Row="2" Grid.Column="0" Tag="5" Content="↙" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=5}"/>
                            <Button Grid.Row="1" Grid.Column="0" Tag="6" Content="←" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=6}"/>
                            <Button Grid.Row="0" Grid.Column="0" Tag="7" Content="↖" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=7}"/>
                            <Border Grid.Row="1" Grid.Column="1" Width="14" Height="14" CornerRadius="7"
                                    Background="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F579;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="スティック / 方向" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="入力" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="130" Height="28" SelectedIndex="{Binding Device, Mode=TwoWay}"
                                      SelectionChanged="StickField_Changed">
                                <ComboBoxItem Content="十字キー"/>
                                <ComboBoxItem Content="左スティック"/>
                                <ComboBoxItem Content="右スティック"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="傾き" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="56" Height="28" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Magnitude, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="%  (スティックのみ)" Foreground="#DDFFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="倒す時間" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Duration, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Text="待機" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Wait, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 待機ブロック ===== -->
        <DataTemplate DataType="{x:Type models:WaitBlock}">
            <Border Background="#FFFFAB19" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x23F1;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="待機する" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center"/>
                        <TextBox Width="74" Height="28" Margin="12,0,3,0" LostFocus="NumberField_LostFocus"
                                 Text="{Binding Seconds, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="秒" Foreground="#FF3B2A00" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 変数 ===== -->
        <DataTemplate DataType="{x:Type models:VariableBlock}">
            <Border Background="#FFFF8C1A" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F516;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="変数" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="90" Height="28" LostFocus="Field_LostFocus"
                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                        <ComboBox Width="64" Height="28" Margin="6,0,0,0" SelectedIndex="{Binding Op, Mode=TwoWay}"
                                  SelectionChanged="Field_SelectionChanged">
                            <ComboBoxItem Content="="/>
                            <ComboBoxItem Content="+="/>
                            <ComboBoxItem Content="-="/>
                            <ComboBoxItem Content="*="/>
                            <ComboBoxItem Content="/="/>
                            <ComboBoxItem Content="++"/>
                            <ComboBoxItem Content="--"/>
                        </ComboBox>
                        <TextBox x:Name="varValue" Width="90" Height="28" Margin="6,0,0,0" LostFocus="Field_LostFocus"
                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0" ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Op}" Value="5">
                    <Setter TargetName="varValue" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Op}" Value="6">
                    <Setter TargetName="varValue" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== ログ出力 ===== -->
        <DataTemplate DataType="{x:Type models:LogBlock}">
            <Border Background="#FF5CB1D6" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F4DD;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ログ出力" FontWeight="Bold" Foreground="#FF06384B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="280" Height="28" LostFocus="Field_LostFocus"
                                 Text="{Binding Text, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0" ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Discord通知 ===== -->
        <DataTemplate DataType="{x:Type models:NotifyBlock}">
            <Border Background="#FFCF63B4" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F4E2;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Discord通知" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="本文" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="300" Height="28" LostFocus="Field_LostFocus"
                                     ToolTip="{}{変数名} で変数値を埋め込めます (例: 現在 {cnt} 回目)"
                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Content="スクショを添付して送る" Foreground="White" VerticalAlignment="Center"
                                      IsChecked="{Binding AttachScreenshot, Mode=TwoWay}" Click="Field_LostFocus"/>
                            <TextBlock Text="（{ } で変数値を埋め込み）" Foreground="#DDFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0" ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== スクショ保存 ===== -->
        <DataTemplate DataType="{x:Type models:ScreenshotBlock}">
            <Border Background="#FF12A89D" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F4F7;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="スクショ保存" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="(日時で自動命名し Captures に保存)" Foreground="#DDFFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0" ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0" ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== ループ(ずっと/回数/条件の間) ===== -->
        <DataTemplate DataType="{x:Type models:LoopBlock}">
            <Border Background="#FFE6A817" CornerRadius="5" Margin="0,0,0,3">
                <StackPanel>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x1F501;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ループ" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="100" Height="28" SelectedIndex="{Binding LoopKind, Mode=TwoWay}"
                                      SelectionChanged="Field_SelectionChanged">
                                <ComboBoxItem Content="ずっと"/>
                                <ComboBoxItem Content="回数"/>
                                <ComboBoxItem Content="条件の間"/>
                            </ComboBox>
                            <StackPanel x:Name="countPanel" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBox Width="56" Height="28" Margin="0,0,3,0" LostFocus="Field_LostFocus"
                                         Text="{Binding Count, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="回" Foreground="#FF3B2A00" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel x:Name="condPanel" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBox Width="80" Height="28" LostFocus="Field_LostFocus"
                                         Text="{Binding Condition.Var, UpdateSourceTrigger=LostFocus}"/>
                                <ComboBox Width="58" Height="28" Margin="4,0" SelectedIndex="{Binding Condition.Op, Mode=TwoWay}"
                                          SelectionChanged="Field_SelectionChanged">
                                    <ComboBoxItem Content="="/><ComboBoxItem Content="&#x2260;"/><ComboBoxItem Content="&lt;"/>
                                    <ComboBoxItem Content="&#x2264;"/><ComboBoxItem Content="&gt;"/><ComboBoxItem Content="&#x2265;"/>
                                </ComboBox>
                                <TextBox Width="80" Height="28" LostFocus="Field_LostFocus"
                                         Text="{Binding Condition.Value, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,3,0" Padding="0" ToolTip="上へ" Click="MoveUp_Click"/>
                            <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,3,0" Padding="0" ToolTip="下へ" Click="MoveDown_Click"/>
                            <Button Content="&#x2715;" Width="30" Height="26" Padding="0" ToolTip="削除" Click="DeleteBlock_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,8,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Children}" Background="#22000000" MinHeight="36" Padding="8,6"/>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LoopKind}" Value="0">
                    <Setter TargetName="countPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LoopKind}" Value="2">
                    <Setter TargetName="countPanel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="condPanel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== 条件分岐(if / else if / else) ===== -->
        <DataTemplate DataType="{x:Type models:IfBlock}">
            <Border Background="#FFE6A817" CornerRadius="5" Margin="0,0,0,3">
                <StackPanel>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2630;" FontSize="12" Foreground="#80000000" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ここをドラッグして移動" Cursor="SizeAll"/><TextBlock Text="&#x2753;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="条件分岐  もし" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="78" Height="28" LostFocus="Field_LostFocus"
                                     Text="{Binding Condition.Var, UpdateSourceTrigger=LostFocus}"/>
                            <ComboBox Width="56" Height="28" Margin="4,0" SelectedIndex="{Binding Condition.Op, Mode=TwoWay}"
                                      SelectionChanged="Field_SelectionChanged">
                                <ComboBoxItem Content="="/><ComboBoxItem Content="&#x2260;"/><ComboBoxItem Content="&lt;"/>
                                <ComboBoxItem Content="&#x2264;"/><ComboBoxItem Content="&gt;"/><ComboBoxItem Content="&#x2265;"/>
                            </ComboBox>
                            <TextBox Width="78" Height="28" LostFocus="Field_LostFocus"
                                     Text="{Binding Condition.Value, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="なら↓" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,3,0" Padding="0" ToolTip="上へ" Click="MoveUp_Click"/>
                            <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,3,0" Padding="0" ToolTip="下へ" Click="MoveDown_Click"/>
                            <Button Content="&#x2715;" Width="30" Height="26" Padding="0" ToolTip="削除" Click="DeleteBlock_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- then 本文 -->
                    <Grid Margin="0,0,8,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Children}" Background="#22000000" MinHeight="36" Padding="8,6"/>
                    </Grid>

                    <!-- でなければもし(elif) 分岐 -->
                    <ItemsControl ItemsSource="{Binding ElseIfs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Margin="12,2,0,2">
                                        <TextBlock Text="でなければもし" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Width="78" Height="28" LostFocus="Field_LostFocus"
                                                 Text="{Binding Condition.Var, UpdateSourceTrigger=LostFocus}"/>
                                        <ComboBox Width="56" Height="28" Margin="4,0" SelectedIndex="{Binding Condition.Op, Mode=TwoWay}"
                                                  SelectionChanged="Field_SelectionChanged">
                                            <ComboBoxItem Content="="/><ComboBoxItem Content="&#x2260;"/><ComboBoxItem Content="&lt;"/>
                                            <ComboBoxItem Content="&#x2264;"/><ComboBoxItem Content="&gt;"/><ComboBoxItem Content="&#x2265;"/>
                                        </ComboBox>
                                        <TextBox Width="78" Height="28" LostFocus="Field_LostFocus"
                                                 Text="{Binding Condition.Value, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="なら↓" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                        <Button Content="&#x2715;" Width="26" Height="26" Padding="0" ToolTip="この分岐を削除" Click="RemoveElseIf_Click"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,8,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Children}" Background="#22000000" MinHeight="36" Padding="8,6"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- でなければ(else) 本文 -->
                    <StackPanel Visibility="{Binding HasElse, Converter={StaticResource B2V}}">
                        <TextBlock Text="でなければ↓" FontWeight="Bold" Foreground="#FF3B2A00" Margin="12,2,0,2"/>
                        <Grid Margin="0,0,8,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding ElseChildren}" Background="#22000000" MinHeight="36" Padding="8,6"/>
                        </Grid>
                    </StackPanel>

                    <!-- オプション追加ボタン -->
                    <StackPanel Orientation="Horizontal" Margin="12,2,0,8">
                        <Button Content="&#x2795; でなければもし" Height="26" Padding="8,2" Margin="0,0,6,0"
                                ToolTip="else if 分岐を追加" Click="AddElseIf_Click"/>
                        <Button Content="&#x2795; でなければ (else)" Height="26" Padding="8,2"
                                ToolTip="else を追加 / 解除" Click="IfElseToggle_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- メニューバー -->
            <RowDefinition Height="Auto"/>  <!-- タブバー -->
            <RowDefinition Height="*"/>     <!-- コンテンツ -->
            <RowDefinition Height="Auto"/>  <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- ===== メニューバー ===== -->
        <Menu Grid.Row="0" Padding="2,1">
            <MenuItem Header="ファイル(_F)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="新規マクロ(_N)" InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem Header="ワークスペースを開く(_O)" InputGestureText="Ctrl+O" Click="MenuOpenWorkspace_Click"/>
                <MenuItem x:Name="RecentMenu" Header="最近の項目(_R)"/>
                <MenuItem Header="上書き保存(_S)" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem Header="名前を付けて保存（コピー）(_C)" Click="MenuSaveAsCopy_Click"/>
                <MenuItem Header="終了(_X)" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="表示(_V)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="ホーム(_H)" Click="MenuHome_Click"/>
                <MenuItem Header="一覧を更新(_R)" Click="MenuRefresh_Click"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="バージョン情報(_A)" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== タブバー(VSCode風) ===== -->
        <Border Grid.Row="1" Background="{StaticResource ShellBgBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="3" Background="#FF5C2D91" Margin="8,0,6,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#x1F9E9;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 固定: ホームタブ -->
                <Border x:Name="HomeTab" Background="{StaticResource EditorBgBrush}" Cursor="Hand"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,2,0,0" Margin="0,0,1,0"
                        MouseLeftButtonUp="HomeTab_Click">
                    <StackPanel Orientation="Horizontal" Margin="12,6">
                        <TextBlock Text="&#x1F3E0;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HomeTabText" Text="ホーム" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 編集中ファイルのタブ -->
                <ItemsControl x:Name="TabBar" ItemTemplate="{StaticResource TabTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- =========================================================
             コンテンツ領域: ホーム / エディタ を切り替え
             ========================================================= -->
        <Grid Grid.Row="2">

            <!-- ===================== ホーム ===================== -->
            <Grid x:Name="HomePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ワークスペース行 -->
                <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" Padding="16,12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ワークスペース:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource EditorBgBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="2"
                                Padding="8,6">
                            <TextBlock x:Name="WorkspacePathText" Text="(未選択)" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="2" Content="フォルダを選択..." Margin="10,0,0,0"
                                Click="ChooseWorkspace_Click"/>
                    </Grid>
                </Border>

                <!-- 一覧 -->
                <Grid Grid.Row="1" Margin="16,14,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="このツールで作成したマクロ" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <ListBox x:Name="MacroList" Grid.Row="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="MacroList_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{StaticResource PanelBgBrush}"
                                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="14,12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="4" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4C4;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SubText}" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="まだマクロがありません。「新規作成」から始めましょう。"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- 下部アクション -->
                <Border Grid.Row="2" Background="{StaticResource ShellBgBrush}" Padding="16,12"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#x1F5D1; 削除" Width="100" Margin="0,0,8,0" Click="Delete_Click"/>
                        <Button Content="&#x270F; 開く / 編集" Width="130" Margin="0,0,8,0" Click="Open_Click"/>
                        <Button Content="&#x2795; 新規作成" Width="130" Style="{StaticResource AccentButton}" Click="New_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== エディタ ===================== -->
            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- エディタツールバー -->
                <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" Padding="14,8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="表示名:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DisplayNameBox" Width="260" Height="30" VerticalAlignment="Center" Margin="0,0,12,0"
                                 TextChanged="DisplayNameBox_TextChanged" LostFocus="Field_LostFocus"/>
                        <Button Content="&#x21B6;" Width="34" Height="30" Margin="0,0,4,0" Padding="0" FontSize="16"
                                ToolTip="元に戻す (Ctrl+Z)" Click="Undo_Click"/>
                        <Button Content="&#x21B7;" Width="34" Height="30" Padding="0" FontSize="16"
                                ToolTip="やり直し (Ctrl+Y)" Click="Redo_Click"/>
                    </StackPanel>
                </Border>

                <!-- 本体: パレット | スクリプト | スプリッタ | プレビュー -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="180"/>
                        <ColumnDefinition Width="*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="380" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- パレット -->
                    <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="ツールボックス" FontWeight="SemiBold" FontSize="13" Margin="2,2,0,8"/>

                            <TextBlock Text="入力" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="2,0,0,4"/>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="press" Background="#FF4C97FF" BorderBrush="#FF3B7DDB">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F3AE;" Margin="2,0,8,0"/><TextBlock Text="ボタン" FontWeight="Bold" Foreground="White"/></StackPanel></Button>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="stick" Margin="0,0,0,10" Background="#FF9966FF" BorderBrush="#FF7A4DDB">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F579;" Margin="2,0,8,0"/><TextBlock Text="スティック" FontWeight="Bold" Foreground="White"/></StackPanel></Button>

                            <TextBlock Text="制御フロー" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="2,0,0,4"/>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="if" Background="#FFE6A817" BorderBrush="#FFC78F0E">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x2753;" Margin="2,0,8,0"/><TextBlock Text="条件分岐" FontWeight="Bold" Foreground="#FF3B2A00"/></StackPanel></Button>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="loop" Background="#FFE6A817" BorderBrush="#FFC78F0E">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F501;" Margin="2,0,8,0"/><TextBlock Text="ループ" FontWeight="Bold" Foreground="#FF3B2A00"/></StackPanel></Button>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="wait" Margin="0,0,0,10" Background="#FFFFAB19" BorderBrush="#FFD98E0F">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x23F1;" Margin="2,0,8,0"/><TextBlock Text="待機" FontWeight="Bold" Foreground="#FF3B2A00"/></StackPanel></Button>

                            <TextBlock Text="データ・通知" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="2,0,0,4"/>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="var" Background="#FFFF8C1A" BorderBrush="#FFD9750E">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F516;" Margin="2,0,8,0"/><TextBlock Text="変数" FontWeight="Bold" Foreground="White"/></StackPanel></Button>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="log" Background="#FF5CB1D6" BorderBrush="#FF3E93B8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F4DD;" Margin="2,0,8,0"/><TextBlock Text="ログ出力" FontWeight="Bold" Foreground="#FF06384B"/></StackPanel></Button>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="notify" Background="#FFCF63B4" BorderBrush="#FFAE4895">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F4E2;" Margin="2,0,8,0"/><TextBlock Text="Discord通知" FontWeight="Bold" Foreground="White"/></StackPanel></Button>
                            <Button Style="{StaticResource PaletteBlockButton}" Tag="screenshot" Margin="0,0,0,10" Background="#FF12A89D" BorderBrush="#FF0C857C">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F4F7;" Margin="2,0,8,0"/><TextBlock Text="スクショ保存" FontWeight="Bold" Foreground="White"/></StackPanel></Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- スクリプト領域 -->
                    <ScrollViewer x:Name="ScriptScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="18"
                                  Background="{StaticResource EditorBgBrush}">
                        <StackPanel>
                            <Border Background="#FF3C7D3C" CornerRadius="5" Padding="14,9" Margin="0,0,0,3">
                                <TextBlock Text="&#x25B6; マクロ開始" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <ItemsControl x:Name="BlocksHost"
                                          PreviewMouseMove="BlocksHost_PreviewMouseMove"
                                          PreviewMouseLeftButtonDown="BlocksHost_PreviewMouseDown"
                                          PreviewMouseLeftButtonUp="BlocksHost_PreviewMouseUp"/>
                            <Border Background="#FF6E3030" CornerRadius="5" Padding="14,9" Margin="0,3,0,0">
                                <TextBlock Text="&#x25A0; マクロ終了" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="EmptyScriptHint"
                                       Text="左のツールボックスからブロックを追加してください。"
                                       Foreground="{StaticResource TextDimBrush}" Margin="4,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- スプリッタ(ブロック⇔プレビューの境界をドラッグでリサイズ) -->
                    <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderStrongBrush}" Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                    <!-- プレビュー -->
                    <Border Grid.Column="3" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="生成されるPython" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,8"/>
                            <Border Grid.Row="1" Background="{StaticResource EditorBgBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="2">
                                <RichTextBox x:Name="PreviewBox" IsReadOnly="True" IsDocumentEnabled="False"
                                             BorderThickness="0" Background="Transparent" Padding="6"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ドラッグ中のゴースト(ラベルチップ)/挿入ライン用オーバーレイ -->
                    <Canvas x:Name="DragOverlay" Grid.Column="0" Grid.ColumnSpan="4"
                            IsHitTestVisible="False" Panel.ZIndex="100">
                        <Border x:Name="InsertLine" Height="3" Width="100" CornerRadius="1.5"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                        <Border x:Name="GhostChip" Visibility="Collapsed" CornerRadius="4" Padding="10,5"
                                Background="#F2007ACC" BorderBrush="White" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="GhostChipIcon" Text="&#x2795;" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock x:Name="GhostChipText" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== ステータスバー(VS風) ===== -->
        <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource PrimaryBrush}" Padding="12,3">
            <TextBlock x:Name="StatusText" Text="準備完了" Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</Window>
