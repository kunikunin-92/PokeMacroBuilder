<Window x:Class="PokeMacroBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PokeMacroBuilder.Models"
        xmlns:conv="clr-namespace:PokeMacroBuilder.Converters"
        Title="PokeMacro Builder" Height="900" Width="1480"
        MinHeight="700" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Background="{StaticResource EditorBgBrush}">

    <Window.Resources>
        <conv:DirectionSelectedConverter x:Key="DirSel"/>

        <!-- ===== タブ(編集中ファイル) ===== -->
        <DataTemplate x:Key="TabTemplate">
            <Border x:Name="tabBd" Background="{StaticResource ShellBgBrush}" Cursor="Hand"
                    BorderBrush="Transparent" BorderThickness="0,2,0,0" Margin="0,0,1,0"
                    MouseLeftButtonUp="Tab_Click">
                <StackPanel Orientation="Horizontal" Margin="12,6,6,6">
                    <TextBlock Text="&#x1F4C4;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="tabName" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#x2715;" Width="18" Height="18" Margin="8,0,0,0" Padding="0" FontSize="9"
                            Click="TabClose_Click" Tag="{Binding}" ToolTip="閉じる"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="tabBd" Property="Background" Value="{StaticResource EditorBgBrush}"/>
                    <Setter TargetName="tabBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="tabName" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="tabName" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== ボタン押下ブロック ===== -->
        <DataTemplate DataType="{x:Type models:PressBlock}">
            <Border Background="#FF4C97FF" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3AE;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ボタンを押す" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Keys}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#33000000" CornerRadius="3" Padding="4,3" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="160" Height="28"
                                                      ItemsSource="{x:Static models:KeyCatalog.All}"
                                                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}"/>
                                            <Button Content="&#x2715;" Width="28" Height="28" Margin="4,0,0,0"
                                                    Padding="0" ToolTip="このキーを削除" Click="RemoveKeySlot_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="&#x2795; キー追加 (同時押し)" Height="28" Padding="10,2"
                                HorizontalAlignment="Left" Click="AddKeySlot_Click"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="押す時間" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Duration, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Text="後で待つ" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Wait, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== スティック / 方向ブロック ===== -->
        <DataTemplate DataType="{x:Type models:StickBlock}">
            <Border Background="#FF9966FF" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 8方向パッド(3x3) -->
                    <Border Grid.Column="0" Background="#33000000" CornerRadius="6" Padding="6" VerticalAlignment="Top">
                        <Grid Width="120" Height="120">
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Tag="0" Content="↑" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=0}"/>
                            <Button Grid.Row="0" Grid.Column="2" Tag="1" Content="↗" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=1}"/>
                            <Button Grid.Row="1" Grid.Column="2" Tag="2" Content="→" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=2}"/>
                            <Button Grid.Row="2" Grid.Column="2" Tag="3" Content="↘" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=3}"/>
                            <Button Grid.Row="2" Grid.Column="1" Tag="4" Content="↓" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=4}"/>
                            <Button Grid.Row="2" Grid.Column="0" Tag="5" Content="↙" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=5}"/>
                            <Button Grid.Row="1" Grid.Column="0" Tag="6" Content="←" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=6}"/>
                            <Button Grid.Row="0" Grid.Column="0" Tag="7" Content="↖" Click="PadButton_Click"
                                    Style="{StaticResource PadButton}" FontSize="18" FontWeight="Bold" Margin="2"
                                    Background="{Binding Direction, Converter={StaticResource DirSel}, ConverterParameter=7}"/>
                            <Border Grid.Row="1" Grid.Column="1" Width="14" Height="14" CornerRadius="7"
                                    Background="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F579;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="スティック / 方向" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="入力" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="130" Height="28" SelectedIndex="{Binding Device, Mode=TwoWay}"
                                      SelectionChanged="StickField_Changed">
                                <ComboBoxItem Content="十字キー"/>
                                <ComboBoxItem Content="左スティック"/>
                                <ComboBoxItem Content="右スティック"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="傾き" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="56" Height="28" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Magnitude, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="%  (スティックのみ)" Foreground="#DDFFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="倒す時間" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Duration, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Text="後で待つ" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Width="64" Height="28" Margin="6,0,3,0" LostFocus="NumberField_LostFocus"
                                     Text="{Binding Wait, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="秒" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 待機ブロック ===== -->
        <DataTemplate DataType="{x:Type models:WaitBlock}">
            <Border Background="#FFFFAB19" CornerRadius="5" Margin="0,0,0,3">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x23F1;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="待機する" FontWeight="Bold" Foreground="#FF3B2A00" VerticalAlignment="Center"/>
                        <TextBox Width="74" Height="28" Margin="12,0,3,0" LostFocus="NumberField_LostFocus"
                                 Text="{Binding Seconds, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="秒" Foreground="#FF3B2A00" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="&#x25B2;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="上へ" Click="MoveUp_Click"/>
                        <Button Content="&#x25BC;" Width="30" Height="26" Margin="0,0,0,3" Padding="0"
                                ToolTip="下へ" Click="MoveDown_Click"/>
                        <Button Content="&#x2715;" Width="30" Height="26" Padding="0"
                                ToolTip="削除" Click="DeleteBlock_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- メニューバー -->
            <RowDefinition Height="Auto"/>  <!-- タブバー -->
            <RowDefinition Height="*"/>     <!-- コンテンツ -->
            <RowDefinition Height="Auto"/>  <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- ===== メニューバー ===== -->
        <Menu Grid.Row="0" Padding="2,1">
            <MenuItem Header="ファイル(_F)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="新規マクロ(_N)" InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem Header="ワークスペースを開く(_O)" InputGestureText="Ctrl+O" Click="MenuOpenWorkspace_Click"/>
                <MenuItem x:Name="RecentMenu" Header="最近の項目(_R)"/>
                <Separator/>
                <MenuItem Header="上書き保存(_S)" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem Header="名前を付けて保存（コピー）(_C)" Click="MenuSaveAsCopy_Click"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="表示(_V)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="ホーム(_H)" Click="MenuHome_Click"/>
                <MenuItem Header="一覧を更新(_R)" Click="MenuRefresh_Click"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="バージョン情報(_A)" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== タブバー(VSCode風) ===== -->
        <Border Grid.Row="1" Background="{StaticResource ShellBgBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="3" Background="#FF5C2D91" Margin="8,0,6,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#x1F9E9;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 固定: ホームタブ -->
                <Border x:Name="HomeTab" Background="{StaticResource EditorBgBrush}" Cursor="Hand"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,2,0,0" Margin="0,0,1,0"
                        MouseLeftButtonUp="HomeTab_Click">
                    <StackPanel Orientation="Horizontal" Margin="12,6">
                        <TextBlock Text="&#x1F3E0;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HomeTabText" Text="ホーム" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 編集中ファイルのタブ -->
                <ItemsControl x:Name="TabBar" ItemTemplate="{StaticResource TabTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- =========================================================
             コンテンツ領域: ホーム / エディタ を切り替え
             ========================================================= -->
        <Grid Grid.Row="2">

            <!-- ===================== ホーム ===================== -->
            <Grid x:Name="HomePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ワークスペース行 -->
                <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" Padding="16,12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ワークスペース:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource EditorBgBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="2"
                                Padding="8,6">
                            <TextBlock x:Name="WorkspacePathText" Text="(未選択)" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="2" Content="フォルダを選択..." Margin="10,0,0,0"
                                Click="ChooseWorkspace_Click"/>
                    </Grid>
                </Border>

                <!-- 一覧 -->
                <Grid Grid.Row="1" Margin="16,14,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="このツールで作成したマクロ" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <ListBox x:Name="MacroList" Grid.Row="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="MacroList_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{StaticResource PanelBgBrush}"
                                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="14,12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="4" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4C4;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SubText}" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="まだマクロがありません。「新規作成」から始めましょう。"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- 下部アクション -->
                <Border Grid.Row="2" Background="{StaticResource ShellBgBrush}" Padding="16,12"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#x1F5D1; 削除" Width="100" Margin="0,0,8,0" Click="Delete_Click"/>
                        <Button Content="&#x270F; 開く / 編集" Width="130" Margin="0,0,8,0" Click="Open_Click"/>
                        <Button Content="&#x2795; 新規作成" Width="130" Style="{StaticResource AccentButton}" Click="New_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== エディタ ===================== -->
            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- エディタツールバー -->
                <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" Padding="14,8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="表示名:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DisplayNameBox" Width="260" Height="30" VerticalAlignment="Center" Margin="0,0,20,0"
                                 TextChanged="DisplayNameBox_TextChanged"/>
                        <TextBlock Text="繰り返し:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="LoopBox" Width="130" Height="30" VerticalAlignment="Center"
                                  SelectionChanged="LoopBox_SelectionChanged">
                            <ComboBoxItem Content="なし (1回)"/>
                            <ComboBoxItem Content="無限ループ"/>
                            <ComboBoxItem Content="回数を指定"/>
                        </ComboBox>
                        <TextBox x:Name="LoopCountBox" Width="64" Height="30" Margin="6,0,0,0"
                                 VerticalAlignment="Center" Text="10" Visibility="Collapsed"
                                 LostFocus="NumberField_LostFocus"/>
                        <TextBlock x:Name="LoopCountUnit" Text="回" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 本体: パレット | スクリプト | プレビュー -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- パレット -->
                    <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="12">
                            <TextBlock Text="ツールボックス" FontWeight="SemiBold" FontSize="13" Margin="2,2,0,10"/>

                            <Button Margin="0,0,0,8" Height="46" HorizontalContentAlignment="Left"
                                    Background="#FF4C97FF" BorderBrush="#FF3B7DDB" Click="AddPress_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F3AE;" FontSize="18" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <TextBlock Text="ボタンを押す" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,0,0,8" Height="46" HorizontalContentAlignment="Left"
                                    Background="#FF9966FF" BorderBrush="#FF7A4DDB" Click="AddStick_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F579;" FontSize="18" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <TextBlock Text="スティック / 方向" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,0,0,8" Height="46" HorizontalContentAlignment="Left"
                                    Background="#FFFFAB19" BorderBrush="#FFD98E0F" Click="AddWait_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x23F1;" FontSize="18" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <TextBlock Text="待機する" FontWeight="Bold" FontSize="14" Foreground="#FF3B2A00" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Background="{StaticResource EditorBgBrush}" CornerRadius="3" Padding="10" Margin="0,12,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ヒント" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               Text="クリックで追加。▲▼またはドラッグで並べ替え。「ボタンを押す」内の『キー追加』で同時押しに。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- スクリプト領域 -->
                    <ScrollViewer x:Name="ScriptScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="18"
                                  Background="{StaticResource EditorBgBrush}">
                        <StackPanel>
                            <Border Background="#FF3C7D3C" CornerRadius="5" Padding="14,9" Margin="0,0,0,3">
                                <TextBlock Text="&#x25B6; マクロ開始" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <ItemsControl x:Name="BlocksHost"
                                          PreviewMouseMove="BlocksHost_PreviewMouseMove"
                                          PreviewMouseLeftButtonDown="BlocksHost_PreviewMouseDown"
                                          PreviewMouseLeftButtonUp="BlocksHost_PreviewMouseUp"/>
                            <Border Background="#FF6E3030" CornerRadius="5" Padding="14,9" Margin="0,3,0,0">
                                <TextBlock Text="&#x25A0; マクロ終了" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="EmptyScriptHint"
                                       Text="左のツールボックスからブロックを追加してください。"
                                       Foreground="{StaticResource TextDimBrush}" Margin="4,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- プレビュー -->
                    <Border Grid.Column="2" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="生成されるPython" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,8"/>
                            <Border Grid.Row="1" Background="{StaticResource EditorBgBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="2">
                                <RichTextBox x:Name="PreviewBox" IsReadOnly="True" IsDocumentEnabled="False"
                                             BorderThickness="0" Background="Transparent" Padding="6"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== ステータスバー(VS風) ===== -->
        <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource PrimaryBrush}" Padding="12,3">
            <TextBlock x:Name="StatusText" Text="準備完了" Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</Window>
